# CLI: somente geração sintética; não aceita caminhos de bases externas.
# A referência é obrigatória/explicita no CLI, sem depender do relógio da máquina.
CI_REFERENCE_DATE=2026-10-22

# API: definir explicitamente no ambiente; este arquivo não é carregado automaticamente.
CUSTOMER_API_DATABASE_PATH=data/synthetic/customer_intelligence.duckdb
CUSTOMER_API_DATA_MODE=synthetic
CUSTOMER_API_READ_ONLY=true
CUSTOMER_API_ENABLE_DOCS=true
CUSTOMER_API_CORS_ORIGINS=http://localhost:5173
CUSTOMER_API_QUERY_TIMEOUT_SECONDS=15
CUSTOMER_API_MEMORY_LIMIT_MB=512
CUSTOMER_API_MAX_ROWS=1000
